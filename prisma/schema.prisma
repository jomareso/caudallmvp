// Caudall MVP — Prisma Schema
// Basado en docs/data-model.md
// Ver docs/decisions.md para las 9 decisiones que gobiernan el modelo

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// BLOQUE 1 — MULTI-TENANT Y USUARIOS
// ============================================================

model Tenant {
  id                           String       @id @default(cuid())
  name                         String
  enrollmentCode               String       @unique
  logoUrl                      String?
  primaryColor                 String       @default("#0F5499")
  secondaryColor               String?
  aggregationMinSegmentSize    Int          @default(5)
  defaultLanguage              String       @default("es")
  status                       TenantStatus @default(PILOT)
  corporateEmailDomain         String?
  methodologyVersionId         String?
  questionBankVersionId        String?
  scoringVersionId             String?
  interventionCatalogVersionId String?
  createdAt                    DateTime     @default(now())
  activatedAt                  DateTime?

  segments              Segment[]
  employees             Employee[]
  adminUsers            AdminUser[]
  evidence              Evidence[]
  interventionOverrides TenantInterventionOverride[]
  learningEvents        LearningEvent[]
  licenses              License[]

  @@map("tenants")
}

// Decisión 6 (actualizada): cada empleado se registra con su propio código
// de licencia individual, no con un código compartido por toda la empresa.
// La empresa contrata N licencias con una vigencia fija (3/6/12 meses); ADM
// las genera en lote desde /admin/empresas. La vigencia empieza a contar
// quien se registra con el código (activatedAt), no desde que se crea —
// una licencia sin usar no vence. Tenant.enrollmentCode se conserva para no
// romper el registro de tenants ya creados con el modelo anterior, pero
// ningún tenant nuevo debería depender de él.
model License {
  id             String        @id @default(cuid())
  tenantId       String
  code           String        @unique
  durationMonths Int
  status         LicenseStatus @default(UNUSED)
  activatedAt    DateTime?
  expiresAt      DateTime?
  createdAt      DateTime      @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  employee Employee?

  @@index([tenantId])
  @@map("licenses")
}

enum LicenseStatus {
  UNUSED
  ACTIVE
  EXPIRED
}

enum TenantStatus {
  PILOT
  ACTIVE
  SUSPENDED
}

model Segment {
  id              String      @id @default(cuid())
  tenantId        String
  name            String
  type            SegmentType
  parentSegmentId String?
  createdAt       DateTime    @default(now())

  tenant    Tenant            @relation(fields: [tenantId], references: [id])
  parent    Segment?          @relation("SegmentHierarchy", fields: [parentSegmentId], references: [id])
  children  Segment[]         @relation("SegmentHierarchy")
  employees EmployeeSegment[]

  @@index([tenantId])
  @@map("segments")
}

enum SegmentType {
  DEPARTMENT
  LOCATION
  ROLE
  CUSTOM
}

model Employee {
  id                 String         @id @default(cuid())
  tenantId           String
  personalEmail      String
  enrollmentCodeUsed String
  // Nullable: empleados de tenants viejos, registrados antes del modelo de
  // licencias individuales, con el código compartido de Tenant.enrollmentCode.
  licenseId          String?        @unique
  authMethod         AuthMethod
  demographicData    Json?
  status             EmployeeStatus @default(REGISTERED)
  createdAt          DateTime       @default(now())
  lastActiveAt       DateTime?

  tenant                 Tenant                  @relation(fields: [tenantId], references: [id])
  license                License?                @relation(fields: [licenseId], references: [id])
  segments               EmployeeSegment[]
  evidence               Evidence[]
  variableStates         VariableState[]
  constructScores        ConstructScore[]
  dimensionScores        DimensionScore[]
  financialState         FinancialState?
  safetyFlags            SafetyFlag[]
  interventions          EmployeeIntervention[]
  pushSubscriptions      PushSubscription[]
  notificationPreference NotificationPreference?
  notificationLogs       NotificationLog[]

  @@unique([tenantId, personalEmail])
  @@index([tenantId])
  @@map("employees")
}

// Decisión 9: PWA con notificaciones push desde el MVP. Una fila por
// dispositivo/navegador suscrito (un empleado puede tener varios). No lleva
// tenantId propio — se resuelve por employeeId, igual que VariableState y
// el resto de tablas "ligadas por employeeId" (ver migración de RLS).
model PushSubscription {
  id         String   @id @default(cuid())
  employeeId String
  endpoint   String   @unique
  p256dh     String
  auth       String
  createdAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("push_subscriptions")
}

// Panel de Configuración del empleado (auditoría UX, revisión 2). Fila
// única por empleado, no una por tipo — son 6 booleanos (5 tipos de
// notificación + el canal de correo), no vale la pena una tabla aparte
// por tipo. Todos empiezan en true (Decisión de UX ya mockeada: "todas
// empiezan activadas, el empleado apaga las que no le interesen").
model NotificationPreference {
  employeeId          String   @id
  emailChannelEnabled Boolean  @default(true)
  commitment          Boolean  @default(true)
  incomplete          Boolean  @default(true)
  resultUpdated       Boolean  @default(true)
  newStep             Boolean  @default(true)
  licenseExpiring     Boolean  @default(true)
  updatedAt           DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

// Reglas de notificación (panel admin /admin/notificaciones): cada fila es
// una instancia configurable de una de las 5 plantillas fijas
// (NotificationType) — el admin puede desactivarla, editar título/cuerpo, o
// (solo INCOMPLETE y LICENSE_EXPIRING, que dependen de un umbral) los días.
// Puede haber más de una instancia por plantilla (ej. dos avisos de
// "incompleto" a distintos días). Tabla de configuración global de
// plataforma, no de datos de empleado — no lleva tenantId ni RLS, mismo
// patrón que Intervention/Methodology/PlatformSettings.
model NotificationRule {
  id           String           @id @default(cuid())
  templateType NotificationType
  enabled      Boolean          @default(true)
  title        String
  body         String
  days         Int?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  logs NotificationLog[]

  @@index([templateType, enabled])
  @@map("notification_rules")
}

// Motor de envío (Decisión 9 + ítem 7 de la auditoría UX): registra cada
// push ya enviado para no repetirlo. refId identifica QUÉ disparó el envío
// dentro de cada regla (el id del EmployeeIntervention para COMMITMENT, el
// id de la Intervention del catálogo para NEW_STEP, el id de la License
// para LICENSE_EXPIRING) — así, si la causa cambia (un compromiso nuevo,
// otra licencia), sí se vuelve a avisar; si sigue siendo la misma, no. Para
// INCOMPLETE y RESULT_UPDATED, que son una única alerta por evento en vez
// de por-entidad, refId queda null. El dedup es por INSTANCIA de regla
// (ruleId), no por plantilla — si el admin crea dos reglas "incompleto" a
// distintos días, cada una lleva su propio historial de envíos.
model NotificationLog {
  id         String   @id @default(cuid())
  employeeId String
  ruleId     String
  refId      String?
  sentAt     DateTime @default(now())

  employee Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  rule     NotificationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([employeeId, ruleId])
  @@map("notification_logs")
}

enum NotificationType {
  COMMITMENT
  INCOMPLETE
  RESULT_UPDATED
  NEW_STEP
  LICENSE_EXPIRING
}

enum AuthMethod {
  MAGIC_LINK
  GOOGLE_OAUTH
}

enum EmployeeStatus {
  REGISTERED
  ACTIVE
  OPTED_OUT
}

model EmployeeSegment {
  employeeId String
  segmentId  String
  assignedAt DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])
  segment  Segment  @relation(fields: [segmentId], references: [id])

  @@id([employeeId, segmentId])
  @@map("employee_segments")
}

// Modelo unificado de administradores: un solo lugar donde, al crear el
// usuario, se define su perfil (a pedido de Reynoso — antes eran dos
// tablas separadas, TenantAdmin y PlatformUser).
//
// ADM = control total de la plataforma (antes PlatformUser/PLATFORM_OWNER).
// EMPRESA = RRHH de un tenant, ve agregados anonimizados de su propia
// empresa (antes TenantAdmin) — tenantId obligatorio para este perfil.
// FUNCIONAL = equipo de Caudall con un rol específico, no control total
// (antes los demás roles de PlatformUser) — functionalRole define cuál.
model AdminUser {
  id             String           @id @default(cuid())
  email          String           @unique
  profileType    AdminProfileType
  functionalRole FunctionalRole?
  tenantId       String?
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now())
  lastActiveAt   DateTime?

  tenant    Tenant?    @relation(fields: [tenantId], references: [id])
  auditLogs AuditLog[]

  @@index([tenantId])
  @@map("admin_users")
}

enum AdminProfileType {
  ADM
  EMPRESA
  FUNCIONAL
}

enum FunctionalRole {
  METHODOLOGIST
  PRODUCT_ADMIN
  ANALYST
  VIEWER
}

// Configuración global de la plataforma Caudall (el logo de Caudall
// mismo, no el de cada empresa cliente — ver Tenant.logoUrl para ese,
// Decisión 3, co-branding por tenant). Fila única: siempre id "singleton".
// Netlify no tiene almacenamiento de archivos persistente, así que el
// logo se guarda como bytes directo en la base de datos (decisión de
// Reynoso: simple para el MVP, sin agregar un servicio de storage nuevo).
model PlatformSettings {
  id           String  @id @default("singleton")
  logoData     Bytes?
  logoMimeType String?

  // Parámetros globales de plataforma editables desde /admin/configuracion
  // (auditoría de valores hardcodeados, 29 ago) — antes eran constantes en
  // código, así que los defaults acá son EXACTAMENTE los valores que ya
  // estaban hardcodeados, para no cambiar comportamiento con el deploy de
  // esta migración. Ver src/lib/settings/platform-settings.ts.
  followupInviteAfterDays Int     @default(90)
  showInterventionVideos  Boolean @default(false)
  licenseDurationsMonths  Int[]   @default([3, 6, 12])
  minCohortSize           Int     @default(30)
  minSampleSize           Int     @default(20)
  magicLinkTtlMinutes     Int     @default(15)

  // Parámetros del motor de diagnóstico (STOP ENGINE) y de las bandas de
  // nivel — editables desde /admin/metodologia/parametros. Mismo criterio
  // que el bloque de arriba: defaults = valores ya hardcodeados en
  // diagnostic.ts/scoring.ts, sin cambio de comportamiento en el deploy.
  stopFloor              Int   @default(8)
  stopSoftMax            Int   @default(15)
  stopHardMax            Int   @default(18)
  highValueThreshold     Float @default(0.9)
  highValueThresholdSoft Float @default(0.97)
  // Meta visual de la barra de progreso en /diagnostico — antes un número
  // suelto (PROGRESS_TARGET=12) desconectado de stopSoftMax/stopHardMax;
  // ahora vive junto a esos valores para que se editen coherentes entre sí.
  progressTarget         Int   @default(12)
  progressTierMidCutoff  Int   @default(41)
  progressTierHighCutoff Int   @default(71)

  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}

// Opciones de disparador para el compromiso de una acción (spec §28/§30:
// implementation intentions) — auditoría de valores hardcodeados, 29 ago.
// Antes una lista fija en código (commitment-triggers.ts); ahora el admin
// puede editar texto/ícono, reordenar, desactivar, o crear una opción
// nueva desde /admin/metodologia/conductual. `code` es estable: queda
// guardado tal cual en EmployeeIntervention.commitmentData.triggerCode, así
// que nunca debería reciclarse para otra cosa — por eso no hay acción de
// borrar, solo desactivar (una fila desactivada sigue resolviendo su label
// para compromisos ya guardados con ese código).
model CommitmentTriggerOption {
  id        String   @id @default(cuid())
  code      String   @unique
  icon      String
  label     String
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("commitment_trigger_options")
}

// Motivos de "en parte"/"todavía no" al reportar un compromiso (spec §29,
// regla CORE 19/20: FRICTION -> TECHNIQUE — alimenta al Learning Engine).
// Mismo criterio que arriba: `code` queda guardado en
// EmployeeIntervention.feedback.reason, solo desactivar, no borrar.
model OutcomeReasonOption {
  id        String   @id @default(cuid())
  code      String   @unique
  label     String
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("outcome_reason_options")
}

// ============================================================
// BLOQUE 2 — METODOLOGÍA Y BANCO (VERSIONADO)
// ============================================================

model Methodology {
  id            String        @id @default(cuid())
  version       String
  status        VersionStatus @default(DRAFT)
  publishedAt   DateTime?
  publishedById String?
  createdAt     DateTime      @default(now())

  dimensions Dimension[]

  @@unique([version])
  @@map("methodologies")
}

enum VersionStatus {
  DRAFT
  IN_REVIEW
  ACTIVE
  DEPRECATED
  ROLLBACK
}

model Dimension {
  id                 String        @id @default(cuid())
  methodologyId      String
  code               DimensionCode
  nameI18nKey        String
  descriptionI18nKey String
  weight             Float         @default(20.0)

  methodology   Methodology    @relation(fields: [methodologyId], references: [id])
  constructs    Construct[]
  variables     Variable[]
  questions     Question[]
  interventions Intervention[]

  @@unique([methodologyId, code])
  @@map("dimensions")
}

enum DimensionCode {
  CONTROL
  RESILIENCE
  DEBT
  SAVING
  PLANNING
}

model Construct {
  id                    String  @id @default(cuid())
  // Nullable: los constructos conductuales (BEH_*) no pertenecen a ninguna
  // de las 5 dimensiones del CFHI (spec: "Behavioral NO constituye una
  // sexta dimensión"). weightWithinDimension queda en 0 para esos casos.
  dimensionId           String?
  code                  String  @unique
  nameI18nKey           String
  weightWithinDimension Float
  // false para constructos conductuales: informan al motor pero nunca
  // entran al promedio ponderado del CFHI (regla CORE #7/#16).
  contributesToCfhi     Boolean @default(true)

  dimension       Dimension?       @relation(fields: [dimensionId], references: [id])
  variablesOwned  Variable[]       @relation("PrimaryOwner")
  questions       Question[]
  constructScores ConstructScore[]
  evidenceOwned   Evidence[]

  @@map("constructs")
}

model Variable {
  id                      String       @id @default(cuid())
  code                    String       @unique
  variableType            VariableType
  dimensionId             String?
  possibleStates          Json
  primaryOwnerConstructId String?
  // Clasificación original del banco maestro (ej. "SCORE/DIAGNOSTIC",
  // "ROUTING/BEHAVIORAL") — más granular que VariableType; se conserva
  // textual para no perder información hasta que el motor la necesite.
  rawType                 String?
  // Nota textual de la columna "Afecta CFHI" del banco (Sí / Sí* / No /
  // No directo) — documental; el motor decide vía primaryOwnerConstructId.
  affectsCfhiNote         String?

  dimension      Dimension?      @relation(fields: [dimensionId], references: [id])
  primaryOwner   Construct?      @relation("PrimaryOwner", fields: [primaryOwnerConstructId], references: [id])
  questions      Question[]
  variableStates VariableState[]
  evidence       Evidence[]

  @@map("variables")
}

enum VariableType {
  SCORE
  CONTEXT
  BEHAVIORAL
  READINESS
  DERIVED
}

model QuestionBank {
  id        String        @id @default(cuid())
  version   String        @unique
  status    VersionStatus @default(DRAFT)
  createdAt DateTime      @default(now())

  questions Question[]

  @@map("question_banks")
}

model Question {
  id                           String        @id @default(cuid())
  bankId                       String
  code                         String
  textI18nKey                  String
  // Nullable: preguntas de rol BEHAVIORAL no pertenecen a una dimensión del
  // CFHI (mismo motivo que Construct.dimensionId).
  dimensionId                  String?
  variableTargetId             String
  constructTargetId            String?
  // Rol funcional dentro del banco (spec §22): ANCHOR se le pregunta a
  // todos; el resto es condicional. Ver docs sobre el motor NBQ pendiente.
  role                         QuestionRole  @default(ADAPTIVE)
  whyAskI18nKey                String?
  askIfRule                    Json?
  skipIfRule                   Json?
  doNotAskIfRule               Json?
  basePriority                 Int           @default(50)
  informationValue             Float         @default(0.5)
  safetyValue                  Float         @default(0.0)
  scoringValue                 Float         @default(0.5)
  routingValue                 Float         @default(0.5)
  rootCauseValue               Float         @default(0.0)
  uncertaintyReduction         Float         @default(0.5)
  burden                       Int           @default(3)
  inferenceSubstitutionAllowed Boolean       @default(true)
  minConfidenceToSkip          Int           @default(80)
  frictionTargetCode           String?
  aiRegenerationAllowed        Boolean       @default(true)
  coreLogicEditable            Boolean       @default(true)
  benchmarkSource              String?
  methodologicalFunction       String?
  behavioralConstructCode      String?
  status                       VersionStatus @default(DRAFT)

  bank            QuestionBank   @relation(fields: [bankId], references: [id])
  dimension       Dimension?     @relation(fields: [dimensionId], references: [id])
  variableTarget  Variable       @relation(fields: [variableTargetId], references: [id])
  constructTarget Construct?     @relation(fields: [constructTargetId], references: [id])
  answerOptions   AnswerOption[]
  evidence        Evidence[]

  @@unique([bankId, code])
  @@index([dimensionId])
  @@map("questions")
}

enum QuestionRole {
  ANCHOR
  ADAPTIVE
  GATE
  BEHAVIORAL
  CONTEXT
  FOLLOWUP
}

model AnswerOption {
  id                   String  @id @default(cuid())
  questionId           String
  order                Int?
  textI18nKey          String
  evidenceProduced     Json
  // Notas del banco maestro que todavía no alimentan ningún motor —
  // se conservan para no perder trabajo, se estructuran cuando se
  // construya el motor que las use.
  secondaryUpdatesNote String?
  frictionCode         String?
  nextCandidatesRaw    String?
  notes                String?

  question Question   @relation(fields: [questionId], references: [id])
  evidence Evidence[]

  @@map("answer_options")
}

model ScoringConfig {
  id                   String        @id @default(cuid())
  version              String        @unique
  status               VersionStatus @default(DRAFT)
  dimensionWeights     Json
  constructWeights     Json
  naRedistributionRule Json

  @@map("scoring_configs")
}

model ForbiddenInference {
  id                 String @id @default(cuid())
  sourceVariableCode String
  sourceValue        String
  targetVariableCode String
  targetValue        String
  reason             String

  @@unique([sourceVariableCode, sourceValue, targetVariableCode, targetValue])
  @@map("forbidden_inferences")
}

// Distinto de ForbiddenInference (relaciones que NUNCA deben inferirse,
// spec §9): esto es el catálogo de inferencias PERMITIDAS que pueden
// sustituir una pregunta cuando la confianza alcanza el umbral (spec §8).
// La condición fuente queda como texto crudo — el intérprete de reglas
// (AND/OR/IN/confidence) todavía no existe, ver docs/prototype README.
model InferenceRule {
  id                    String        @id @default(cuid())
  code                  String        @unique
  type                  InferenceType
  sourceConditionRaw    String
  targetVariableCode    String
  targetValue           String
  confidence            Float
  canSubstituteQuestion Boolean       @default(false)
  affectedQuestionCodes String[]
  notes                 String?

  @@map("inference_rules")
}

enum InferenceType {
  STRONG
  WEAK
}

// Casos de prueba de metodología (spec §50 "QA OBLIGATORIO" / personas).
// Referencia para validar el banco antes de publicar una versión; no se
// ejecuta automáticamente todavía.
model MethodologyQaScenario {
  id             String @id @default(cuid())
  code           String @unique
  scenario       String
  precondition   String
  expectedResult String
  severity       String

  @@map("methodology_qa_scenarios")
}

// Catálogo fricción → técnica conductual (spec §economía conductual /
// BEHAVIORAL DESIGN). FRICTION → TECHNIQUE, nunca al revés (regla CORE #19).
model BehavioralTechnique {
  id                 String  @id @default(cuid())
  frictionCode       String
  technique          String
  useWhen            String
  avoidWhen          String
  copyTransformation String
  example            String?

  @@map("behavioral_techniques")
}

// Mapa de sesgos/constructos conductuales usados para decidir cuándo
// preguntar y qué NO concluir de una respuesta (evita el error metodológico
// de interpretar un síntoma downstream como causa raíz, regla CORE #9).
model BehavioralBiasMap {
  id                    String  @id @default(cuid())
  construct             String
  whatItDetects         String
  whenToAsk             String
  whatNotToConclude     String
  candidateIntervention String
  benchmarks            String?

  @@map("behavioral_bias_map")
}

// ============================================================
// BLOQUE 3 — ESTADO VIVO DEL EMPLEADO
// ============================================================

model Evidence {
  id                      String         @id @default(cuid())
  tenantId                String
  employeeId              String
  source                  EvidenceSource
  questionId              String?
  answerOptionId          String?
  variableId              String
  value                   Json
  reliability             Reliability
  confidence              Int
  primaryOwnerConstructId String?
  timestamp               DateTime       @default(now())
  period                  DateTime?
  methodologyVersionId    String

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  employee     Employee      @relation(fields: [employeeId], references: [id])
  question     Question?     @relation(fields: [questionId], references: [id])
  answerOption AnswerOption? @relation(fields: [answerOptionId], references: [id])
  variable     Variable      @relation(fields: [variableId], references: [id])
  primaryOwner Construct?    @relation(fields: [primaryOwnerConstructId], references: [id])

  @@index([tenantId, employeeId])
  @@index([employeeId, variableId])
  @@map("evidence")
}

enum EvidenceSource {
  QUESTION
  INFERENCE
  INTEGRATION
}

enum Reliability {
  DIRECT
  STRONG_INFERENCE
  WEAK_INFERENCE
}

model VariableState {
  employeeId             String
  variableId             String
  value                  Json
  confidence             Int
  state                  String
  derivedFromEvidenceIds String[]
  updatedAt              DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])
  variable Variable @relation(fields: [variableId], references: [id])

  @@id([employeeId, variableId])
  @@map("variable_states")
}

model ConstructScore {
  employeeId  String
  constructId String
  score       Float
  confidence  Int
  computedAt  DateTime @default(now()) @updatedAt

  employee  Employee  @relation(fields: [employeeId], references: [id])
  construct Construct @relation(fields: [constructId], references: [id])

  @@id([employeeId, constructId])
  @@map("construct_scores")
}

model DimensionScore {
  employeeId       String
  dimensionId      String
  score            Float
  state            DimensionState
  confidence       Int
  driverVariableId String?
  computedAt       DateTime       @default(now()) @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@id([employeeId, dimensionId])
  @@map("dimension_scores")
}

enum DimensionState {
  MET
  PARTIAL
  UNMET
  CRITICAL
  NA
}

model FinancialState {
  employeeId                String    @id
  cfhiScore                 Float
  cfhiConfidence            Int
  userGoal                  Json?
  systemPriority            String?
  rootCause                 String?
  eligibility               Json?
  finReadiness              String?
  behReadiness              String?
  lastDiagnosticCompletedAt DateTime?
  // Los tres campos de abajo miden SOLO la parte financiera (GATE/ANCHOR/
  // ADAPTIVE/FOLLOWUP/BEHAVIORAL) — el bloque de contexto es aparte,
  // opcional y no cuenta para "cuánto toma el diagnóstico" (ver
  // src/lib/engines/diagnostic-stats.ts). diagnosticStartedAt se fija una
  // sola vez, en la primera respuesta; los otros dos se fijan al terminar
  // (finalizeDiagnostic), como snapshot — no se recalculan después.
  diagnosticStartedAt       DateTime?
  diagnosticDurationSeconds Int?
  questionsAnsweredCount    Int?
  updatedAt                 DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@map("financial_states")
}

model SafetyFlag {
  id          String    @id @default(cuid())
  employeeId  String
  flagCode    String
  raisedAt    DateTime  @default(now())
  evidenceIds String[]
  resolvedAt  DateTime?

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@map("safety_flags")
}

// ============================================================
// BLOQUE 4 — INTERVENCIONES Y CONTENIDO
// ============================================================

model InterventionCatalog {
  id        String        @id @default(cuid())
  version   String        @unique
  status    VersionStatus @default(DRAFT)
  createdAt DateTime      @default(now())

  interventions Intervention[]

  @@map("intervention_catalogs")
}

model Intervention {
  id                          String           @id @default(cuid())
  catalogId                   String
  type                        InterventionType
  dimensionId                 String
  appliesToStates             String[]
  appliesToStages             String[]
  financialReadinessRequired  String?
  behavioralReadinessRequired String?
  behavioralTechniqueCode     String?
  titleI18nKey                String
  descriptionI18nKey          String
  actionTextI18nKey           String?
  whyThisStepI18nKey          String?
  videoUrl                    String?

  catalog           InterventionCatalog          @relation(fields: [catalogId], references: [id])
  dimension         Dimension                    @relation(fields: [dimensionId], references: [id])
  tenantOverrides   TenantInterventionOverride[]
  employeeInstances EmployeeIntervention[]

  @@map("interventions")
}

enum InterventionType {
  EDUCATIONAL_CONTENT
  BEHAVIORAL_ACTION
  COMMITMENT
  REMINDER
  // Contenido de mantenimiento (video corto) para cuando una dimensión ya
  // está MET — a diferencia de los demás tipos, no responde a una fricción
  // (regla CORE 19), es contenido educativo general para reforzar el hábito.
  COURSE
}

model TenantInterventionOverride {
  tenantId       String
  interventionId String
  status         OverrideStatus

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  intervention Intervention @relation(fields: [interventionId], references: [id])

  @@id([tenantId, interventionId])
  @@map("tenant_intervention_overrides")
}

enum OverrideStatus {
  ENABLED
  DISABLED
}

model EmployeeIntervention {
  id             String                     @id @default(cuid())
  employeeId     String
  interventionId String
  assignedAt     DateTime                   @default(now())
  status         EmployeeInterventionStatus @default(SUGGESTED)
  commitmentData Json?
  completedAt    DateTime?
  outcome        InterventionOutcome?
  feedback       Json?

  employee     Employee     @relation(fields: [employeeId], references: [id])
  intervention Intervention @relation(fields: [interventionId], references: [id])

  @@index([employeeId])
  @@map("employee_interventions")
}

enum EmployeeInterventionStatus {
  SUGGESTED
  COMMITTED
  IN_PROGRESS
  COMPLETED
  DISMISSED
}

enum InterventionOutcome {
  ACHIEVED
  PARTIAL
  NOT_ACHIEVED
}

// ============================================================
// BLOQUE 5 — AUDITORÍA, VERSIONADO Y APRENDIZAJE
// ============================================================

model AuditLog {
  id            String   @id @default(cuid())
  whoId         String
  whoData       Json
  what          String
  when          DateTime @default(now())
  previousValue Json?
  newValue      Json?
  entityType    String
  entityId      String

  who AdminUser @relation(fields: [whoId], references: [id])

  @@index([entityType, entityId])
  @@map("audit_logs")
}

model LearningEvent {
  id         String            @id @default(cuid())
  eventType  LearningEventType
  employeeId String?
  tenantId   String
  context    Json
  timestamp  DateTime          @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, timestamp])
  @@map("learning_events")
}

enum LearningEventType {
  QUESTION_SHOWN
  QUESTION_ANSWERED
  QUESTION_ABANDONED
  DIAGNOSTIC_COMPLETED
  INTERVENTION_SUGGESTED
  INTERVENTION_COMMITTED
  INTERVENTION_COMPLETED
  INTERVENTION_DISMISSED
  OUTCOME_REPORTED
}

// Comparación con pares (benchmark nacional, CLAUDE.md: "diferenciador
// clave frente a ChatGPT"). Cada fila es UN encuestado anonimizado de los
// Estudios de Salud Financiera de Reynoso (2021-2024) — no es dato de un
// empleado de Caudall, es contenido de referencia de la plataforma, igual
// que Question/Variable/Intervention: sin tenantId propio, sin RLS (mismo
// criterio que esas tablas, ver 20260826225832_enable_rls, que
// deliberadamente no las incluye).
//
// NO incluye Resiliencia: el estudio de origen no la mide por separado
// (esa pregunta quedó mezclada dentro de "Ahorro" en el instrumento
// viejo, justo la confusión que prohíbe la Regla CORE #5) — decisión
// explícita de Reynoso: comparar solo el score general y Control/Ahorro/
// Deuda/Planificación hasta que exista un estudio que mida Resiliencia
// aparte. Ver prisma/seed-data/scripts/convert-national-benchmark.py
// para el mapeo completo desde los datos originales.
model NationalBenchmarkRecord {
  id               String   @id @default(cuid())
  version          String
  studyYear        Int?
  sourceLabel      String
  sex              String?
  ageBand          String?
  educationLevel   String?
  employmentStatus String?
  dependents       String?
  incomeRangeRaw   String?
  controlScore     Float
  savingScore      Float
  debtScore        Float
  planningScore    Float
  overallScore     Float
  condition        String?
  createdAt        DateTime @default(now())

  @@index([version])
  @@index([ageBand])
  @@index([employmentStatus])
  @@index([educationLevel])
  @@map("national_benchmark_records")
}

// ============================================================
// BLOQUE 6 — CONTENIDO DE LANDINGS (administrable desde /admin)
// ============================================================
//
// Copy de las landings públicas (empleador/RRHH y colaborador), editable
// por ADM sin tocar código. Igual que Question/Intervention/
// NationalBenchmarkRecord: contenido de plataforma, no de un tenant ni de
// un empleado — sin tenantId propio, sin RLS (mismo criterio que esas
// tablas, ver 20260826225832_enable_rls).
//
// Fase 1 (actual): edición directa, sin versionado ni borrador/preview/
// publicación — lo que se guarda se refleja de inmediato. Eso queda para
// una fase posterior si Reynoso lo pide.
enum LandingSlug {
  EMPLEADOR
  COLABORADOR
}

model LandingPage {
  id        String      @id @default(cuid())
  slug      LandingSlug @unique
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  blocks LandingBlock[]

  @@map("landing_pages")
}

// `content` es Json porque cada `type` de bloque tiene una forma de
// campos distinta (headline con dos líneas, timeline con hitos, etc.) —
// la forma concreta por tipo se valida con zod en landing-content.ts, no
// a nivel de base de datos.
model LandingBlock {
  id            String   @id @default(cuid())
  landingPageId String
  type          String
  order         Int
  visible       Boolean  @default(true)
  content       Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  landingPage LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)

  // Fase 1: un bloque por tipo por landing (ver src/lib/landing/blocks.ts)
  // — no hay todavía UI para agregar bloques repetidos del mismo tipo.
  @@unique([landingPageId, type])
  @@index([landingPageId])
  @@map("landing_blocks")
}

// Banco de imágenes del panel de contenido (ej. fotos de los estudios en
// la sección de metodología). Netlify no tiene storage persistente, así
// que igual que PlatformSettings.logoData, los bytes se guardan directo
// en la base de datos.
model MediaAsset {
  id        String   @id @default(cuid())
  filename  String
  mimeType  String
  data      Bytes
  size      Int
  createdAt DateTime @default(now())

  @@map("media_assets")
}
