# ============================================================
# CAUDALL MVP — Variables de entorno
# Copia este archivo como .env.local y completa los valores.
# NUNCA commitees .env.local al repo.
# ============================================================

# Base de datos PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/caudall_dev"

# NextAuth / Auth.js
AUTH_SECRET=""  # Generar con: openssl rand -base64 32
AUTH_URL="http://localhost:3000"

# Email (Resend recomendado para magic links)
RESEND_API_KEY=""
EMAIL_FROM="Caudall <no-reply@caudall.com>"

# OAuth con Google (cuenta personal — ADR-008)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Configuración de la plataforma
NEXT_PUBLIC_APP_URL="http://localhost:3000"
